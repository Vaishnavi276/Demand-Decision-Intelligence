# Demand Decision Intelligence - Environment Variables Example
# Copy this file to .env and replace with your production values

# Pinned 256-bit (>= 32 bytes) secret key for HS256 JWT tokens
SECRET_KEY=generate_a_random_32_byte_hex_string_here_e_g_openssl_rand_hex_32

# Token Lifespans
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Connection
DATABASE_URL=postgresql+psycopg2://postgres_user:change_password@localhost:5432/demand_decision_db

# CORS Allowed Origins (Comma-separated or JSON list; no wildcards)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# SKU Auto-Provisioning Flag
AUTO_CREATE_UNKNOWN_SKUS=true

# LLM & Decision Assistant APIs (Optional - Falls back to deterministic synthesis if unset)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
